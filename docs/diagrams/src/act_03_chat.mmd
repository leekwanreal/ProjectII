flowchart TB
  subgraph L1["👤 Khách / Học viên"]
    direction TB
    S((" ")):::start
    A1["Mở widget chat"]:::act
    A2["Nhập tên, liên hệ, chủ đề"]:::act
    A4["Gửi câu hỏi"]:::act
    A6["Đọc phản hồi"]:::act
  end
  subgraph L2["🖥 Hệ thống (Socket.IO)"]
    direction TB
    B0{"Có sessionId<br/>đã lưu?"}:::dec
    B1["Tạo phiên WAITING,<br/>đưa vào hàng đợi"]:::act
    B1b["Khôi phục phiên<br/>+ lịch sử tin nhắn"]:::good
    B2["Thông báo hàng đợi<br/>tới tư vấn viên"]:::act
    B3["Phiên → ACTIVE,<br/>gửi tin hệ thống"]:::good
    B4["Lưu tin nhắn,<br/>phát tới phòng chat"]:::act
    B5["Phiên → CLOSED"]:::act
  end
  subgraph L3["👤 Tư vấn viên"]
    direction TB
    C1["Xem hàng đợi"]:::act
    C2["Nhận phiên"]:::act
    C3["Trả lời"]:::act
    C4{"Đã giải đáp xong?"}:::dec
  end
  E((" ")):::start
  S --> A1 --> B0
  B0 -- "Không" --> A2 --> B1 --> B2 --> C1 --> C2 --> B3 --> A4
  B0 -- "Có" --> B1b --> A4
  A4 --> B4 --> C3 --> B4
  B4 --> A6 --> C4
  C4 -- "Chưa" --> A4
  C4 -- "Rồi" --> B5 --> E
classDef start fill:#14213D,stroke:#14213D,color:#fff
classDef act fill:#EAF1FB,stroke:#1F4E8C,stroke-width:1.5px,color:#14213D
classDef dec fill:#FFF4D6,stroke:#C9A227,stroke-width:2px,color:#14213D
classDef bad fill:#FDECEC,stroke:#B3261E,stroke-width:1.5px,color:#14213D
classDef good fill:#E6F4EA,stroke:#2E7D32,stroke-width:1.5px,color:#14213D
