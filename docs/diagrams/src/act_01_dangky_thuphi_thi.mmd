flowchart TB
  subgraph L1["👤 Học viên"]
    direction TB
    S((" ")):::start
    A1["Chọn khoá / lớp, mở form đăng ký"]:::act
    A2["Nhập thông tin cá nhân,<br/>hình thức, ca mong muốn"]:::act
    A5["Nhận mã hồ sơ DK-YYYY-NNNN"]:::act
    A6["Chọn phương thức thanh toán"]:::act
    A9["Làm bài kiểm tra 20 câu / 20 phút"]:::act
    E((" ")):::start
  end
  subgraph L2["🖥 Hệ thống"]
    direction TB
    B1{"Dữ liệu hợp lệ?"}:::dec
    B3{"Đã có hồ sơ hiệu lực<br/>cùng khoá?"}:::dec
    B2["Tìm / tạo học viên,<br/>tạo hồ sơ PENDING_PAYMENT"]:::act
    B4["Ghi nhận payment,<br/>hồ sơ → PAID"]:::good
    B5{"Hồ sơ đã PAID? (BR-01)"}:::dec
    B6["Từ chối 403:<br/>yêu cầu nộp học phí"]:::bad
    B7["Chấm điểm, quy đổi CEFR,<br/>hồ sơ → TESTED"]:::good
    B8["Báo lỗi từng trường"]:::bad
  end
  subgraph L3["💳 Cổng thanh toán"]
    direction TB
    C1{"Giao dịch thành công?"}:::dec
  end
  subgraph L4["🏢 Văn phòng (Giáo vụ)"]
    direction TB
    D1["Nhận kết quả kiểm tra<br/>để xếp lớp"]:::act
  end
  S --> A1 --> A2 --> B1
  B1 -- "Không" --> B8 --> A2
  B1 -- "Có" --> B3
  B3 -- "Có" --> B8
  B3 -- "Không" --> B2 --> A5 --> A6 --> C1
  C1 -- "Không" --> A6
  C1 -- "Có" --> B4 --> B5
  B5 -- "Chưa" --> B6
  B5 -- "Rồi" --> A9 --> B7 --> D1 --> E
classDef start fill:#14213D,stroke:#14213D,color:#fff
