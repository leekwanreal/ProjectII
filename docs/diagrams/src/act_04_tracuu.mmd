flowchart LR
  subgraph L1["👤 Khách"]
    direction TB
    S((" ")):::start
    A1["Nhập từ khoá / chọn bộ lọc:<br/>chứng chỉ, hình thức, ca,<br/>trình độ, khai giảng, còn chỗ"]:::act
    A3["Xem kết quả,<br/>chọn Đăng ký lớp này"]:::act
    A4["Xoá / nới bộ lọc"]:::act
  end
  subgraph L2["🖥 Hệ thống"]
    direction TB
    B1["Chuẩn hoá tham số,<br/>dựng câu truy vấn có tham số"]:::act
    B2["Tính sĩ số & trạng thái sĩ số<br/>theo BR-02, BR-03"]:::act
    B3{"Có kết quả?"}:::dec
    B4["Hiển thị thẻ lớp + badge<br/>Chưa đủ / Đủ mở / Đầy / Chờ duyệt"]:::good
    B5["Thông báo không có lớp phù hợp"]:::bad
  end
  E((" ")):::start
  S --> A1 --> B1 --> B2 --> B3
  B3 -- "Có" --> B4 --> A3 --> E
  B3 -- "Không" --> B5 --> A4 --> A1
classDef start fill:#14213D,stroke:#14213D,color:#fff
classDef act fill:#EAF1FB,stroke:#1F4E8C,stroke-width:1.5px,color:#14213D
classDef dec fill:#FFF4D6,stroke:#C9A227,stroke-width:2px,color:#14213D
classDef bad fill:#FDECEC,stroke:#B3261E,stroke-width:1.5px,color:#14213D
classDef good fill:#E6F4EA,stroke:#2E7D32,stroke-width:1.5px,color:#14213D
